// Web Worker — mirrors Python multiprocessing.Pool worker process
// Offloads seam carve pipeline off main thread → UI stays responsive

import { generateInverseMirrorSeed, seedMatrixToEnergyBias } from '../utils/piLogicEnergy';

const computeEnergy = (imageData, width, height, bias) => {
  const energy = new Float64Array(width * height);  // numbers.Real → Float64Array
  for (let y = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const idx  = (y * width + x) * 4;
      const gray = 0.299*imageData[idx] + 0.587*imageData[idx+1] + 0.114*imageData[idx+2];
      const lIdx = (y * width + Math.max(0, x-1)) * 4;
      const rIdx = (y * width + Math.min(width-1, x+1)) * 4;
      const tIdx = (Math.max(0, y-1) * width + x) * 4;
      const bIdx = (Math.min(height-1, y+1) * width + x) * 4;
      const gL = 0.299*imageData[lIdx] + 0.587*imageData[lIdx+1] + 0.114*imageData[lIdx+2];
      const gR = 0.299*imageData[rIdx] + 0.587*imageData[rIdx+1] + 0.114*imageData[rIdx+2];
      const gT = 0.299*imageData[tIdx] + 0.587*imageData[tIdx+1] + 0.114*imageData[tIdx+2];
      const gB = 0.299*imageData[bIdx] + 0.587*imageData[bIdx+1] + 0.114*imageData[bIdx+2];
      const dx = gR - gL;
      const dy = gB - gT;
      const val = Math.abs(Math.sin(dx)) + Math.abs(Math.cos(dy));
      energy[y * width + x] = isNaN(val) ? 0 : val * (1 + bias[y * width + x]);
    }
  }
  return energy;
};

const findSeam = (energy, width, height) => {
  const cost = new Float64Array(energy);
  for (let y = 1; y < height; y++) {
    for (let x = 0; x < width; x++) {
      const top  = cost[(y-1) * width + x];
      const topL = x > 0         ? cost[(y-1) * width + (x-1)] : Infinity;
      const topR = x < width - 1 ? cost[(y-1) * width + (x+1)] : Infinity;
      cost[y * width + x] += Math.min(top, topL, topR);
    }
  }
  const seam = new Int32Array(height);  // numbers.Integral → Int32Array
  let minCol = 0, minVal = Infinity;
  for (let x = 0; x < width; x++) {
    if (cost[(height-1) * width + x] < minVal) {
      minVal = cost[(height-1) * width + x];
      minCol = x;
    }
  }
  seam[height-1] = minCol;
  for (let y = height-2; y >= 0; y--) {
    const prev = seam[y+1];
    let best = prev, bestVal = cost[y * width + prev];
    if (prev > 0 && cost[y * width + (prev-1)] < bestVal) { best = prev-1; bestVal = cost[y * width + (prev-1)]; }
    if (prev < width-1 && cost[y * width + (prev+1)] < bestVal) { best = prev+1; }
    seam[y] = best;
  }
  return seam;
};

const removeSeam = (data, seam, width, height) => {
  const newWidth = width - 1;
  const result = new Uint8ClampedArray(newWidth * height * 4);
  for (let y = 0; y < height; y++) {
    let destX = 0;
    for (let x = 0; x < width; x++) {
      if (x === seam[y]) continue;
      const s = (y * width + x) * 4;
      const d = (y * newWidth + destX) * 4;
      result[d] = data[s]; result[d+1] = data[s+1];
      result[d+2] = data[s+2]; result[d+3] = data[s+3];
      destX++;
    }
  }
  return { data: result, width: newWidth, height };
};

// Worker message handler — mirrors multiprocessing Pool.map worker function
self.onmessage = (e) => {
  const { imageData, width, height, seamCount, seedSize } = e.data;

  const seedMatrix = generateInverseMirrorSeed(seedSize || 10);
  const energyLog  = [];
  let data = new Uint8ClampedArray(imageData);
  let w = width, h = height;

  for (let i = 0; i < seamCount; i++) {
    const bias   = seedMatrixToEnergyBias(seedMatrix, w, h);
    const energy = computeEnergy(data, w, h, bias);
    const avg    = energy.reduce((a, b) => a + b, 0) / energy.length;
    energyLog.push(parseFloat(avg.toFixed(6)));
    const seam   = findSeam(energy, w, h);
    ({ data, width: w, height: h } = removeSeam(data, seam, w, h));

    // Progress update — mirrors multiprocessing callback
    self.postMessage({ type: 'progress', seam: i + 1, total: seamCount });
  }

  self.postMessage({
    type: 'complete',
    data: data.buffer,
    width: w,
    height: h,
    energyLog,
    seedMatrix,
  }, [data.buffer]);  // transfer buffer — zero-copy, mirrors shared_memory
};
```

