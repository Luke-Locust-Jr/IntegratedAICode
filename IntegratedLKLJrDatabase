**`utils/fileValidator.js` — fnmatch-style pattern matching for upload filtering:**
```js
// Mirrors Python fnmatch shell pattern behavior
// fnmatch('image.JPG', '*.jpg') → true (case-normalized on Windows)

const FILE_PATTERNS = ['*.jpg', '*.jpeg', '*.png', '*.webp', '*.bmp'];

const fnmatch = (filename, pattern) => {
  const normalized = filename.toLowerCase();
  const regexStr = pattern
    .toLowerCase()
    .replace(/\./g, '\\.')   // escape dots
    .replace(/\*/g, '.*')    // * → matches everything
    .replace(/\?/g, '.');    // ? → matches any single character
  return new RegExp(`^${regexStr}$`).test(normalized);
};

export const fnmatchFilter = (names, pat) =>
  names.filter(name => fnmatch(name, pat));

export const validateImageFile = (filename) =>
  FILE_PATTERNS.some(pat => fnmatch(filename, pat));
```

